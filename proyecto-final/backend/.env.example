# Plantilla de configuración.
# Copiar este archivo como .env (en esta misma carpeta) y completar los valores.
# El .env real NO se sube al repositorio (está en .gitignore).

# Clave de la YouTube Data API v3
YOUTUBE_API_KEY=

# "video" (por ahora es el único soportado)
TARGET_TYPE=video
# ID del video: lo que sigue a "watch?v=" en la URL
TARGET_ID=

# Segundos entre consultas a YouTube
POLL_INTERVAL=5
# Duración de cada ventana de análisis, en segundos
WINDOW_SECONDS=10
# Tamaño máximo de las colas internas
MAX_QUEUE=5000
# Modelo de Hugging Face para el análisis de sentimiento
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
